generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Raffle {
  id             String    @id @default(cuid())
  name           String
  description    String?
  prize          String
  ticketPrice    Decimal   @db.Decimal(12, 2)
  totalTickets   Int       @default(10000)
  drawDate       DateTime
  isActive       Boolean   @default(true)
  externalResult String?
  winnerNumber   Int?
  winnerId       String?
  winner         Client?   @relation("RaffleWinner", fields: [winnerId], references: [id])
  tickets        Ticket[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Client {
  id         String    @id @default(cuid())
  name       String
  phone      String
  email      String?
  notes      String?
  city       String?
 tickets    Ticket[]
  payments   Payment[]
  wonRaffles Raffle[]  @relation("RaffleWinner")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([phone])
  @@index([name])
}

model Ticket {
  id             String       @id @default(cuid())
  number         Int
  token          String       @unique @default(cuid())
  status         TicketStatus @default(AVAILABLE)
  amountPaid     Decimal?     @db.Decimal(12, 2)
  raffleId       String
  raffle         Raffle       @relation(fields: [raffleId], references: [id])
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id])
  payments       Payment[]
  reservedAt     DateTime?
  paidAt         DateTime?
  assignedById   String?
  assignedByName String?
  assignedBy     User?        @relation("TicketAssignedBy", fields: [assignedById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([raffleId, number])
  @@index([status])
  @@index([token])
  @@index([clientId])
}

enum TicketStatus {
  AVAILABLE
  RESERVED
  PARTIAL
  PAID
  RELEASED
  
}

model Payment {
  id            String        @id @default(cuid())
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod @default(MANUAL)
  status        PaymentStatus @default(PENDING)
  reference     String?
  notes         String?
  ticketId      String
  ticket        Ticket        @relation(fields: [ticketId], references: [id])
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  confirmedAt   DateTime?
  createdById   String?
  createdByName String?
  createdBy     User?         @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([ticketId])
  @@index([clientId])
  @@index([status])
}

enum PaymentMethod {
  MANUAL
  YAPE
  NEQUI
  BANCOLOMBIA
  MERCADO_PAGO
  CASH
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  REFUNDED
}

model User {
  id              String    @id @default(cuid())
  username        String    @unique
  passwordHash    String
  role            UserRole  @default(VENDEDOR)
  name            String
  isActive        Boolean   @default(true)
  assignedTickets Ticket[]  @relation("TicketAssignedBy")
  createdPayments Payment[] @relation("PaymentCreatedBy")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum UserRole {
  ADMIN
  VENDEDOR
}
